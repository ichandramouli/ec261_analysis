EU261_data <- EU261_data |>
mutate(EU261_active=ifelse(((Year>2005)|(Year==2005 & Month>2)),'Yes','No'))
#lets just do the summary first to see what we're look
EU261_data |>
group_by(city_pair) |>
summarise(total_seats=sum(Total)) |>
arrange(desc(total_seats)) |>
head(20)
