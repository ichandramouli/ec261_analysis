color='City Pair'
) + geom_vline(xintercept=as.Date('2005-02-17'))
ggplot(data=EU261_top20_only,mapping=aes(x=EU261_active,y=Total)) + geom_boxplot()
EU261_before |>
filter(carriergroup==0) |>
group_by(city_pair) |>
summarise(total_seats=sum(Total)) |>
arrange(desc(total_seats)) |>
head(20)
EU261_after |>
filter(carriergroup==0) |>
group_by(city_pair) |>
summarise(total_seats=sum(Total)) |>
