library(tidyverse)
library(tidytext)
flt_data_1990s <- read_csv('data/flt_data_1990_2000.csv') #1991 to 2000
flt_data_2000s <- read_csv('data/flt_data_2000_2010.csv') #2001 to 2010
flt_data_2011_2015 <- read_csv('data/flt_data_2010_2015.csv') #2011 to 2015
flt_data_2016_2025 <- read_csv('data/flt_data_2015_2025.csv') #2016 to 2025
flt_data_90s_wider <- flt_data_1990s |>
select(-Scheduled,-Charter,-Primary_Key) |>
pivot_wider(names_from=type,values_from=Total)
flt_data_00s_wider <- flt_data_2000s |>
select(-Scheduled,-Charter,-Primary_Key) |>
pivot_wider(names_from=type,values_from=Total)
flt_data_early10s_wider <- flt_data_2011_2015 |>
select(-Scheduled,-Charter,-Primary_Key) |>
pivot_wider(names_from=type,values_from=Total)
flt_data_2016_2025_wider <- flt_data_2016_2025 |>
filter(carrier!='CP') |>
select(-Scheduled,-Charter,-Primary_Key) |>
pivot_wider(names_from=type,values_from=Total)
flt_data_merged <- bind_rows(flt_data_90s_wider,flt_data_00s_wider,flt_data_early10s_wider,flt_data_2016_2025_wider)
flt_data_merged <- flt_data_merged |>
mutate(city_pair=str_c(usg_apt,fg_apt,sep='-'))
flt_data_merged <- flt_data_merged |>
mutate(decade=case_when(Year>=2020~'2020s',
Year>=2010~'2010s',
Year>=2000~'2000s',
Year>1990~'1990s'))
flt_data_merged <- flt_data_merged |>
filter(is.na(Seats)==F & is.na(Passengers)==F) |>
mutate(load_factor=Passengers/Seats)
flt_data_merged <- flt_data_merged |>
mutate(carriergroup=factor(carriergroup,levels=c('1','0'))) |>
mutate(carriergroup=fct_recode(carriergroup,
'Domestic'='1',
'Foreign'='0'
))
top_5_df <- flt_data_merged |>
group_by(city_pair,decade) |>
summarise(pax_count=sum(Passengers,na.rm=T)) |>
group_by(decade) |>
slice_max(pax_count,n=5) |>
mutate(city_pair=reorder_within(city_pair,pax_count,decade))
#adapted from https://juliasilge.com/blog/reorder-within/ to get the ordering within the decade facet to work. This made use of reorder_within() which reorders within each facet by appending the facet to the end of strings.  Scale_y_reordered is then used in the plot to eliminate the facet appendage in the axis labels.
ggplot(data=top_5_df,mapping=aes(x=pax_count,y=city_pair)) + geom_col() + facet_wrap(~decade,scales='free_y') +
scale_y_reordered() +
labs(title='Top 5 International Air Routes by Passenger Traffic by Decade',
x='Passenger Count',
y='Route') +
theme_bw()
japan_data_summarized <- flt_data_merged |>
select(Year,city_pair,Passengers) |>
filter(Year > 2005 & Year < 2025 & city_pair %in% c('HNL-NRT','HNL-HND','LAX-NRT','LAX-HND')) |>
group_by(Year,city_pair) |>
summarise(pax_count=sum(Passengers))
ggplot(data=japan_data_summarized,mapping=aes(x=Year,y=pax_count,color=city_pair)) + geom_line(linewidth=1) +
labs(title='Los Angeles and Honolulu to Tokyo Route Passenger Counts (2005-2024)',
x='Year',
y='Passenger Count',
color='City Pair') +
theme_bw()
japan_tokyo_consolidated <- japan_data_summarized |>
mutate(consolidated_route=case_when(
city_pair %in% c('LAX-NRT','LAX-HND') ~ 'Los Angeles-Tokyo',
city_pair %in% c('HNL-NRT','HNL-HND') ~ 'Honolulu-Tokyo'
)) |>
group_by(Year,consolidated_route) |>
summarise(consolidated_pax_count=sum(pax_count))
ggplot(data=japan_tokyo_consolidated,mapping=aes(x=Year,y=consolidated_pax_count,color=consolidated_route)) + geom_line(linewidth=1) +
labs(title='Tokyo Passenger Counts (All Airports, 2005-2024)',
x='Year',
y= 'Passenger Traffic',
color='Route') +
theme_bw()
india_flt_data <- flt_data_merged |>
filter((Year==2021 | Year==2024) & fg_wac==733 & fg_apt!='JAI') |>
select(Year,fg_apt,carriergroup,Passengers) |>
group_by(Year,fg_apt,carriergroup) |>
summarise(pax_count=sum(Passengers)) |>
mutate(fg_apt=case_when(
fg_apt=='DEL'~ 'Delhi',
fg_apt=='BOM'~'Mumbai',
fg_apt=='BLR'~'Bengaluru',
fg_apt=='HYD'~'Hyderabad'
))
#filtered out Jaipur due to one-off diversion
ggplot(data=india_flt_data,mapping=aes(x=fct_reorder(fg_apt,pax_count),y=pax_count,fill=carriergroup)) +
geom_col() +
facet_wrap(~Year) +
labs(title='US-India International Passenger Traffic Before and After Russian Overflight Restrictions',
x='Indian City',
y='Passenger Count',
fill='Airline Country Group') +
theme(axis.text.x = element_text(size=10),
legend.position = 'bottom')
#https://stackoverflow.com/questions/13297995/changing-font-size-and-direction-of-axes-text-in-ggplot2#:~:text=To%20change%20the%20font%20size%20and%20direction,1%2C%20vjust%20=%200%2C%20face%20=%20%22plain%22)%60
ggplot(data=japan_tokyo_consolidated,mapping=aes(x=Year,y=consolidated_pax_count,color=consolidated_route)) + geom_line(linewidth=1) +
labs(title='Tokyo Passenger Counts (All Airports, 2005-2024)',
x='Year',
y= 'Passenger Traffic',
color='Route') +
theme_bw()
View(india_flt_data)
flt_data |>
filter(year==2021&ft_apt=='HYD')
flt_data_merged |>
filter(year==2021&fg_apt=='HYD')
filter(Year==2021&fg_apt=='HYD')
filter(Year==2021&fg_apt=='HYD')
flt_data_merged |>
filter(Year==2021 & fg_apt=='HYD')
View(top_5_df)
View(top_5_df)
